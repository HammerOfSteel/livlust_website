# Copy this file to .env and fill in values

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=livlust
POSTGRES_PASSWORD=changeme
POSTGRES_DB=livlust_db

# ── Directus CMS ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomUUID())"
DIRECTUS_KEY=replace-with-random-uuid
DIRECTUS_SECRET=replace-with-long-random-string

DIRECTUS_ADMIN_EMAIL=admin@livlust.se
DIRECTUS_ADMIN_PASSWORD=changeme

# ── Frontend ───────────────────────────────────────────────
# URL to reach Directus admin from the BROWSER (not Docker-internal)
VITE_CMS_URL=http://localhost:8055

# Theme: ocean | forest | nordic | sunset | lavender
VITE_THEME=ocean

# ── Google Calendar (Kommande aktiviteter / upcoming events) ───────────────
# Public calendar (info@livslusths.se) is the single source of truth for
# events — no more duplicating events into Directus. Create a browser API
# key in Google Cloud Console (enable "Google Calendar API", Credentials ->
# Create API key, restrict to Calendar API, and to your domain's HTTP
# referrer before deploying to production).
VITE_GOOGLE_CALENDAR_API_KEY=changeme
VITE_GOOGLE_CALENDAR_ID=info@livslusths.se

# ── Email (Directus outgoing mail, e.g. contact-form notifications) ────────
# Simply.com's own SMTP blocks/blocklists mail from datacenter/VPS IPs, so it
# can't be used from this server — use a transactional provider instead.
# EMAIL_TRANSPORT=smtp works with any SMTP relay (e.g. Brevo: host
# smtp-relay.brevo.com, port 587, login/password from Brevo's SMTP & API
# settings page). EMAIL_TRANSPORT=mailgun uses Mailgun's HTTP API instead
# (needs a paid plan for a real custom domain — free tier is sandbox-only).
EMAIL_FROM=info@livslusths.se
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=changeme
EMAIL_SMTP_PASSWORD=changeme
EMAIL_SMTP_SECURE=false
EMAIL_MAILGUN_API_KEY=changeme
EMAIL_MAILGUN_DOMAIN=changeme
EMAIL_MAILGUN_HOST=api.mailgun.net
# Address that receives new contact-form submissions (defaults to EMAIL_FROM
# if unset, in directus/seed.mjs)
CONTACT_NOTIFICATION_EMAIL=info@livslusths.se

# ── Listmonk (newsletter) ────────────────────────────────────
# Separate Postgres database, isolated from the Directus one above.
LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=changeme
LISTMONK_DB_NAME=listmonk

# Only used to auto-create the Super Admin user on first install. Once it
# exists you can leave these as-is (or blank) — they're ignored afterwards.
# Listmonk has no native Mailgun API support — its own Settings -> SMTP page
# needs Mailgun's actual SMTP credentials (smtp.mailgun.org:587, username
# postmaster@<your-domain>, password from the SMTP Credentials tab — NOT
# the API key above), entered directly in the Listmonk admin UI.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=changeme
